{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderDatabase": "Host=localhost;Port=5434;Database=order_db;Username=order_service;Password=order_service"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Downstream": {
    "ProductService": {
      "BaseUrl": "http://localhost:8081",
      "AttemptTimeoutMs": 2000,
      "TotalTimeoutMs": 8000,
      "MaxRetries": 2,
      "BaseRetryDelayMs": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 8,
      "CircuitBreakerSamplingDurationMs": 30000,
      "CircuitBreakerBreakDurationMs": 15000
    },
    "UserService": {
      "BaseUrl": "http://localhost:8000",
      "AttemptTimeoutMs": 2000,
      "TotalTimeoutMs": 8000,
      "MaxRetries": 2,
      "BaseRetryDelayMs": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 8,
      "CircuitBreakerSamplingDurationMs": 30000,
      "CircuitBreakerBreakDurationMs": 15000
    }
  }
}
