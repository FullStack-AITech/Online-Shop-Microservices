# Copy to .env for local development. Never commit a real .env.
USER_SERVICE_ENVIRONMENT=local
USER_SERVICE_LOG_LEVEL=INFO

# Database-per-service: the User Service owns this database and nothing else touches it.
# Postgres (docker compose): postgresql+psycopg://user_service:user_service@user-db:5432/user_db
# Local without Postgres:    sqlite+pysqlite:///./user_service.db
USER_SERVICE_DATABASE_URL=sqlite+pysqlite:///./user_service.db

# Create tables on startup. Fine for local/dev; production should use migrations instead.
USER_SERVICE_CREATE_TABLES_ON_STARTUP=true
