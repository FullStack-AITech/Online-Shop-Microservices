# Copy to .env for local development. Never commit a real .env.
PAYMENT_SERVICE_ENVIRONMENT=local
PAYMENT_SERVICE_LOG_LEVEL=INFO

# Database-per-service: the Payment Service owns this database and nothing else touches it.
# The schema comes from Alembic: run `alembic upgrade head` before starting the service.
# Postgres (docker compose): postgresql+psycopg://payment_service:payment_service@payment-db:5432/payment_db
# Postgres (from the host):  postgresql+psycopg://payment_service:payment_service@localhost:5435/payment_db
# Local without Postgres:    sqlite+pysqlite:///./payment_service.db
PAYMENT_SERVICE_DATABASE_URL=sqlite+pysqlite:///./payment_service.db

# Only the fake provider exists. It declines any amount above the threshold.
PAYMENT_SERVICE_PAYMENT_PROVIDER=fake
PAYMENT_SERVICE_FAKE_DECLINE_ABOVE=1000.00

# The consumer (python -m app.consumer). kafka:9092 inside Compose.
PAYMENT_SERVICE_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
PAYMENT_SERVICE_KAFKA_ORDERS_TOPIC=orders
PAYMENT_SERVICE_KAFKA_PAYMENTS_TOPIC=payments
PAYMENT_SERVICE_KAFKA_GROUP_ID=payment-service
